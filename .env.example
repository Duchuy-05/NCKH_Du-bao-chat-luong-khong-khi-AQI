# Local Docker Compose settings. Change these values before exposing the stack.
POSTGRES_DB=airvision
POSTGRES_USER=airvision
POSTGRES_PASSWORD=airvision_dev_password
POSTGRES_PORT=5432

# Used to protect the admin training endpoint.
INTERNAL_API_KEY=change-this-local-development-key

# Must point to the API as seen by the user's browser.
VITE_API_BASE_URL=http://localhost:3000/api
CORS_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

DATA_SYNC_ENABLED=true
DATA_SYNC_TIMES=06:00,18:00
