# PostgreSQL used by local backend development.
DATABASE_URL=postgresql+psycopg://airvision:change_me@localhost:5432/airvision
CITY=hanoi

INTERNAL_API_KEY=replace-with-a-separate-random-key
CORS_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Background Open-Meteo refresh (run a full historical import once after migration).
DATA_SYNC_ENABLED=true
DATA_SYNC_TIMES=06:00,18:00
